# Generated by Ansible - the "proxy" role. Manual edits here get
# overwritten the next time the playbook runs; change the template
# instead (ansible/roles/proxy/templates/nginx.conf.j2).
#
# This is Requirement 5's actual traffic router - the thing a browser or
# curl actually talks to, which then decides which region's real cluster
# should handle the request.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # "upstream" is NGINX's own term for a named pool of backend servers a
    # request can be sent to. West Europe is listed first with no special
    # marking, which makes it the preferred choice while it's healthy;
    # Germany West Central is marked "backup" - NGINX only ever sends
    # traffic there if every non-backup server in the pool is currently
    # considered down.
    #
    # "max_fails=2 fail_timeout=10s" is the actual health-check mechanism:
    # after 2 failed attempts to reach West Europe, NGINX marks it down for
    # 10 seconds and routes new requests to the backup instead - then tries
    # West Europe again after that window, in case it's recovered. This is
    # a passive check (based on real proxied requests failing), which is
    # what's available in open-source NGINX - active, independent
    # health-probing is an NGINX Plus (paid) feature.
    upstream hello_world_backend {
        server {{ primary_backend }}:80 max_fails=2 fail_timeout=10s;
        server {{ backup_backend }}:80 backup;
    }

    server {
        listen 80;
        listen 443 ssl;

        ssl_certificate     /etc/nginx/ssl/proxy-selfsigned.crt;
        ssl_certificate_key /etc/nginx/ssl/proxy-selfsigned.key;

        location / {
            proxy_pass http://hello_world_backend;
            proxy_set_header Host $host;

            # Deliberately short timeouts - the whole point of this demo
            # is a fast, visible failover, not a browser hanging for 60
            # seconds (NGINX's own default) before giving up on a region
            # that's actually down.
            proxy_connect_timeout 3s;
            proxy_read_timeout 5s;

            # Tells NGINX to also try the next upstream (the backup) if the
            # one it just tried times out or returns a server error -
            # without this, a single failed request could be shown to the
            # user as an error instead of silently retried against the
            # healthy region.
            proxy_next_upstream error timeout http_502 http_503 http_504;
        }
    }
}
